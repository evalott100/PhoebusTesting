    <name>Beam_1</name>
    <x>40</x>
    <y>230</y>
    <width>2065</width>
    <height>1</height>
    <points>
      <point x="0.0" y="0.0">
      </point>
      <point x="2064.044423877834" y="0.0">
      </point>
    </points>
    <line_width>4</line_width>
    <line_color>
      <color red="0" green="255" blue="255">
      </color>
    </line_color>
    <actions>
    </actions>
    <scripts>
      <script file="../BLGuiApp_opi/beam.py">
        <pv_name>loc://shouldFlip</pv_name>
        <pv_name>=indexOf('FE21I-RS-ABSB-01:STA')==1?0:"auto(FE.Absorber)"</pv_name>
        <pv_name>=indexOf('FE21I-VA-VALVE-02:STA')==1?0:"auto(FE.V2)"</pv_name>
        <pv_name>=indexOf('FE21I-PS-SHTR-02:STA')==1?0:"auto(FE.Shutter)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-FMASK-01:STA')==1?0:"auto(FM)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-ABSB-02:STA')==1?0:"auto(ABS2)"</pv_name>
        <pv_name>=indexOf('BL21I-PS-SHTR-01:STA')==1?0:"auto(SH1)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-VALVE-13:STA')==1?0:"auto(V13)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-VALVE-14:STA')==1?0:"auto(V14)"</pv_name>
        <pv_name>=indexOf('BL21I-OP-SHTR-01:STATUS')==1?0:"auto(FS1)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-VALVE-15:STA')==1?0:"auto(V15)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-VALVE-16:STA')==1?0:"auto(V16)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-VALVE-17:STA')==1?0:"auto(V17)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-VALVE-18:STA')==1?0:"auto(V18)"</pv_name>
        <pv_name>=indexOf('BL21I-VA-VALVE-19:STA')==1?0:"auto(V19)"</pv_name>
        <pv_name>="auto(ANDOR)"</pv_name>
      </script>
    </scripts>
    <tooltip>$(pv_name)
$(pv_value)</tooltip>
  </widget>
